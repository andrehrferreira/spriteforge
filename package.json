{
    "name": "spriteforge",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n backup,vite \"node server/server.mjs\" \"vite\"",
        "server": "node server/server.mjs",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.4",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.61.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.8"
    },
    "dependencies": {
        "fflate": "^0.8.3",
        "upng-js": "^2.1.0"
    }
}
