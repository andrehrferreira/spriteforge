{
  "name": "spriteforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backup,vite \"node server/server.mjs\" \"vite\"",
    "server": "node server/server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "upng-js": "^2.1.0"
  }
}
